# ════════════════════════════════════════════════════════════════════
#  Переменные окружения. Скопируй в .env (локально) и добавь в
#  Vercel → Settings → Environment Variables (на проде).
# ════════════════════════════════════════════════════════════════════

# ── Supabase: серверная часть (API /api/*) ───────────────────────────
# SUPABASE_URL  — Project URL из Supabase → Settings → API
# SUPABASE_KEY  — service_role key (секретный! только на сервере/Vercel)
SUPABASE_URL="https://ВАШ-ПРОЕКТ.supabase.co"
SUPABASE_KEY="ВАШ_SERVICE_ROLE_KEY"

# ── Supabase: клиентская часть (загрузка фото товаров в Storage) ─────
# Те же значения, но ключ — публичный anon key (НЕ service_role).
# Префикс VITE_ обязателен, иначе Vite не прокинет их в браузер.
VITE_SUPABASE_URL="https://ВАШ-ПРОЕКТ.supabase.co"
VITE_SUPABASE_ANON_KEY="ВАШ_ANON_KEY"

# ── ЮKassa (опционально, для реальной онлайн-оплаты) ─────────────────
# Без этих ключей работает тестовая оплата картой (форма на сайте).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
