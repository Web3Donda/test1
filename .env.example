# ════════════════════════════════════════════════════════════════════
#  Переменные окружения. Скопируй в .env (локально) и добавь в
#  Vercel → Settings → Environment Variables (на проде).
# ════════════════════════════════════════════════════════════════════

# ── Supabase (всё через API /api/*, в т.ч. загрузка фото) ────────────
# SUPABASE_URL  — Project URL из Supabase → Settings → API
# SUPABASE_KEY  — secret key (sb_secret_... или service_role). Только на сервере!
SUPABASE_URL="https://ВАШ-ПРОЕКТ.supabase.co"
SUPABASE_KEY="ВАШ_SECRET_KEY"

# ── ЮKassa (опционально, для реальной онлайн-оплаты) ─────────────────
# Без этих ключей работает тестовая оплата картой (форма на сайте).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""

# ── Timeweb S3 (российское хранилище фото товаров) ───────────────────
# Получить в Timeweb Cloud → Хранилище S3 → твой бакет → S3-ключи.
TIMEWEB_S3_KEY=""
TIMEWEB_S3_SECRET=""

# ── PIN админки ──────────────────────────────────────────────────────
# 4-значный код для входа в админ-панель салона. Проверяется на сервере,
# на фронт не попадает. При смене — выдай новый код хозяйке.
ADMIN_PIN=""
